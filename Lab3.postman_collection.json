          "name": "01 Успешный запрос",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('errorCode', function () { pm.expect(body.errorCode).to.eql(''); });",
                  "pm.test('code', function () { pm.expect(body.code).to.eql('success'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"uid\": \"1\",\r\n  \"operationUid\": \"operation-1\",\r\n  \"systemName\": \"CRM\",\r\n  \"systemTime\": \"2026-10-16T10:00:00Z\",\r\n  \"source\": \"lab2\",\r\n  \"communicationId\": 1,\r\n  \"templateId\": 1,\r\n  \"productCode\": 1,\r\n  \"smsCode\": 1234\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/feedback",
